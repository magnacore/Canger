<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Domain model: filesystem objects, settings, tabs, commands, macros, signals, task queue, file operations.</Description>
    <!-- The LibraryImport source generator emits unsafe marshalling code for the libc
         bindings in Native/. No hand-written unsafe code exists in this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The domain models version-control status directly, as ranger does: it is
         part of what a listing shows, not a decoration layered on afterwards.
         Canger.Vcs depends on nothing itself, so this adds no transitive weight. -->
    <ProjectReference Include="../Canger.Vcs/Canger.Vcs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests exercise the native decode helpers directly rather than only through the
         public surface, so that a layout mistake in Native/ is caught precisely. -->
    <InternalsVisibleTo Include="Canger.Core.Tests" />
  </ItemGroup>

</Project>
