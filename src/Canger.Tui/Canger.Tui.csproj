<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Terminal layer: raw mode, diffing screen buffer, input decoding, keybinding trie, character widths.</Description>
    <!-- The LibraryImport source generator emits unsafe marshalling code for the termios
         bindings in Native/. No hand-written unsafe code exists in this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Canger.Core/Canger.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runner needs a real terminal to be useful, so the decisions it makes that are not
         about drawing are tested directly instead. -->
    <InternalsVisibleTo Include="Canger.Tui.Tests" />
  </ItemGroup>

</Project>
